{
  "schema": "bigso-diagrams/sidecar@1",
  "elements": {
    "gateway": {"description": "Punto de entrada de la API; valida la sesión y enruta la operación.", "annotations": ["Frontera pública", "No contiene lógica de pedidos"]},
    "stock": {"description": "Consulta y reserva existencias antes de autorizar el pago."},
    "payment": {"description": "Autoriza el cargo una vez que la reserva de inventario está confirmada."}
  },
  "journeys": [
    {"id": "pedido-disponible", "title": "Pedido con existencias disponibles", "description": "Camino exitoso desde el carrito hasta la confirmación.", "steps": [
      {"id": "solicitar-carrito", "title": "El cliente entrega el carrito", "transition": {"from": "customer", "to": "cart"}},
      {"id": "enrutar-solicitud", "title": "El gateway enruta el pedido", "transition": {"from": "cart", "to": "gateway"}},
      {"id": "consultar-stock", "title": "Se consulta inventario", "transition": {"from": "gateway", "to": "stock"}},
      {"id": "evaluar-disponibilidad", "title": "Se confirma disponibilidad", "transition": {"from": "stock", "to": "available"}},
      {"id": "autorizar-pago", "title": "Se autoriza el pago", "transition": {"from": "available", "to": "payment"}},
      {"id": "crear-pedido", "title": "Se registra el pedido", "transition": {"from": "payment", "to": "create"}},
      {"id": "confirmar", "title": "Se notifica la confirmación", "transition": {"from": "create", "to": "notify"}}
    ]},
    {"id": "pedido-sin-stock", "title": "Pedido sin existencias", "description": "Camino alterno que rechaza el pedido sin autorizar el pago.", "steps": [
      {"id": "solicitar-carrito", "title": "El cliente entrega el carrito", "transition": {"from": "customer", "to": "cart"}},
      {"id": "enrutar-solicitud", "title": "El gateway enruta el pedido", "transition": {"from": "cart", "to": "gateway"}},
      {"id": "consultar-stock", "title": "Se consulta inventario", "transition": {"from": "gateway", "to": "stock"}},
      {"id": "evaluar-disponibilidad", "title": "No hay existencias", "transition": {"from": "stock", "to": "available"}},
      {"id": "rechazar-pedido", "title": "Se informa el rechazo", "transition": {"from": "available", "to": "reject"}}
    ]}
  ]
}
